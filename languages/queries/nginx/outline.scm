; A whole block owns its children; names are the directive or route.
(attribute (keyword) @name (block)) @definition.module
(directive (keyword) @name (block)) @definition.module
(location (location_route) @name) @definition.module
(map (var) @name) @definition.module
(if condition: (condition) @name) @definition.module
(attribute (keyword) @name) @definition.property
(directive (keyword) @name) @definition.property
